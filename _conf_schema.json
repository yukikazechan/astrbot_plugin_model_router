{
    "plugin_enabled": {
        "type": "bool",
        "description": "启用模型路由",
        "default": true
    },
    "default_provider_id": {
        "type": "string",
        "description": "未命中规则时使用的服务商",
        "hint": "可留空。留空时不覆盖 AstrBot 已选择的模型。",
        "_special": "select_provider",
        "default": ""
    },
    "default_model_name": {
        "type": "string",
        "description": "未命中规则时使用的模型名称",
        "hint": "留空则使用所选服务商的默认模型。",
        "default": ""
    },
    "routing_rules": {
        "type": "template_list",
        "description": "模型路由规则",
        "hint": "从上到下匹配，命中第一条后停止。可添加关键字、正则或指定用户规则；作用范围留空表示所有群聊和私聊。",
        "default": [],
        "templates": {
            "keyword_rule": {
                "name": "关键字路由",
                "hint": "消息包含任一或全部关键字时选择指定模型。",
                "items": {
                    "rule_enabled": {
                        "type": "bool",
                        "description": "启用规则",
                        "default": true
                    },
                    "rule_name": {
                        "type": "string",
                        "description": "规则名称",
                        "default": "关键字规则"
                    },
                    "keywords": {
                        "type": "list",
                        "description": "关键字",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "hint": "每项填写一个关键字。"
                    },
                    "match_mode": {
                        "type": "string",
                        "description": "匹配方式",
                        "options": [
                            "any",
                            "all"
                        ],
                        "default": "any",
                        "hint": "any=包含任一个；all=必须包含全部。"
                    },
                    "case_sensitive": {
                        "type": "bool",
                        "description": "区分大小写",
                        "default": false
                    },
                    "scope_id": {
                        "type": "string",
                        "description": "群号或会话 ID（可选）",
                        "hint": "留空表示所有会话；可填写群号或 unified_msg_origin。",
                        "default": ""
                    },
                    "provider_id": {
                        "type": "string",
                        "description": "目标服务商",
                        "_special": "select_provider",
                        "default": ""
                    },
                    "model_name": {
                        "type": "string",
                        "description": "目标模型名称",
                        "hint": "留空则使用目标服务商的默认模型。",
                        "default": ""
                    }
                }
            },
            "regex_rule": {
                "name": "正则路由",
                "hint": "消息被正则表达式搜索命中时选择指定模型。",
                "items": {
                    "rule_enabled": {
                        "type": "bool",
                        "description": "启用规则",
                        "default": true
                    },
                    "rule_name": {
                        "type": "string",
                        "description": "规则名称",
                        "default": "正则规则"
                    },
                    "pattern": {
                        "type": "string",
                        "description": "正则表达式",
                        "hint": "使用 Python 正则语法，通过 re.search 匹配整条消息。",
                        "default": ""
                    },
                    "case_sensitive": {
                        "type": "bool",
                        "description": "区分大小写",
                        "default": false
                    },
                    "scope_id": {
                        "type": "string",
                        "description": "群号或会话 ID（可选）",
                        "hint": "留空表示所有会话；可填写群号或 unified_msg_origin。",
                        "default": ""
                    },
                    "provider_id": {
                        "type": "string",
                        "description": "目标服务商",
                        "_special": "select_provider",
                        "default": ""
                    },
                    "model_name": {
                        "type": "string",
                        "description": "目标模型名称",
                        "hint": "留空则使用目标服务商的默认模型。",
                        "default": ""
                    }
                }
            },
            "user_rule": {
                "name": "指定用户路由",
                "hint": "指定发送者始终使用某个模型，可选限定群聊或会话。",
                "items": {
                    "rule_enabled": {
                        "type": "bool",
                        "description": "启用规则",
                        "default": true
                    },
                    "rule_name": {
                        "type": "string",
                        "description": "规则名称",
                        "default": "用户规则"
                    },
                    "sender_id": {
                        "type": "string",
                        "description": "发送者 ID",
                        "default": ""
                    },
                    "scope_id": {
                        "type": "string",
                        "description": "群号或会话 ID（可选）",
                        "hint": "留空表示该用户在所有会话生效；可填写群号或 unified_msg_origin。",
                        "default": ""
                    },
                    "provider_id": {
                        "type": "string",
                        "description": "目标服务商",
                        "_special": "select_provider",
                        "default": ""
                    },
                    "model_name": {
                        "type": "string",
                        "description": "目标模型名称",
                        "hint": "留空则使用目标服务商的默认模型。",
                        "default": ""
                    }
                }
            }
        }
    }
}
